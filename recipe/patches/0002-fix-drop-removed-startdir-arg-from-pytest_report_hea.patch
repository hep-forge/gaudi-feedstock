From 22752905d2221404d6b485f075093eff71eacbb4 Mon Sep 17 00:00:00 2001
From: Chris Burr <christopher.burr@cern.ch>
Date: Fri, 10 Jul 2026 23:57:57 +0200
Subject: [PATCH] fix: drop removed startdir arg from pytest_report_header
 hookimpl

pytest 9 removed the startdir argument from the pytest_report_header
hookspec (deprecated since pytest 7 in favour of start_path), so
pluggy's hookimpl validation now rejects the ctest_measurements_reporter
plugin with a PluginValidationError and every pytest invocation driven
by ctest aborts before collection.

Declaring only the arguments we use is valid for pluggy hookimpls, so
dropping startdir keeps the plugin working with pytest 7 and 8 while
fixing pytest 9. To be submitted upstream.
---
 GaudiPolicy/python/GaudiTesting/pytest/ctest_measurements_reporter.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/GaudiPolicy/python/GaudiTesting/pytest/ctest_measurements_reporter.py b/GaudiPolicy/python/GaudiTesting/pytest/ctest_measurements_reporter.py
index b640c7e..2f093d9 100644
--- a/GaudiPolicy/python/GaudiTesting/pytest/ctest_measurements_reporter.py
+++ b/GaudiPolicy/python/GaudiTesting/pytest/ctest_measurements_reporter.py
@@ -35,7 +35,7 @@ def sanitize_for_xml(data):
     return bad_chars.sub(quote, data)
 
 
-def pytest_report_header(config, start_path, startdir):
+def pytest_report_header(config, start_path):
     # make sure CTest does not drop output lines on successful tests
     return "CTEST_FULL_OUTPUT"
 
