 import sys
 
 
+def _open_db(path):
+    """Open a .confdb2 file: a pickled dict (written by merge_confdb2_parts
+    on Python < 3.13) or a shelve database."""
+    import pickle
+    import shelve
+
+    with open(path, "rb") as f:
+        is_pickle = f.read(1) == b"\x80"
+    if is_pickle:
+        with open(path, "rb") as f:
+            return pickle.load(f)
+    return shelve.open(path, "r")
+
+
